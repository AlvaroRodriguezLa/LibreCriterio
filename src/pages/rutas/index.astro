---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResumeReading from '../../components/ResumeReading.astro';
import parts from '../../data/routes.json';import book from '../../data/book.json';
import {buildBook} from '../../lib/reading-book.mjs';
import {getPublishedArticles,articlePath,readingTime,sitePath} from '../../lib/content';
const articles=await getPublishedArticles();const chapters=buildBook(parts);const first=chapters[0];const find=(slug:string)=>articles.find(a=>a.data.slug===slug);
const totalMinutes=chapters.reduce((sum,c)=>sum+readingTime(find(c.slug)?.body||''),0);
---
<BaseLayout title={book.title+' · Índice'} description={book.description}><section class="wrapper book-cover"><p class="eyebrow">UN LIBRO ABIERTO · {parts.length} PARTES · {chapters.length} CAPÍTULOS</p><h1>Una vida<br/><em>propia.</em></h1><p class="book-subtitle">{book.subtitle}</p><p class="book-introduction">{book.introduction}</p><p class="book-estimate">Álvaro Rodríguez · Unas {totalMinutes} min en conjunto, a tu ritmo.</p><ResumeReading/><div class="book-cover-actions"><a class="book-primary-link" href={articlePath(first.slug)}>Empezar por el capítulo 1 →</a><a class="text-button" href="#indice">Explorar el índice ↓</a></div></section>
<div class="wrapper" id="indice"><div class="book-parts">{parts.map((part,index)=><section class="book-part" id={'ruta-'+part.id}><header class="book-part-header"><span>PARTE {index+1}</span><div><h2>{part.title}</h2><p>{part.opening}</p></div></header><ol class="book-chapter-list">{chapters.filter(c=>c.partId===part.id).map(c=>{const a=find(c.slug);return a&&<li id={'capitulo-'+c.slug}><a href={articlePath(c.slug)} data-book-chapter={c.slug}><span class="chapter-number">{String(c.number).padStart(2,'0')}</span><div><h3>{a.data.title}</h3><p>{a.data.excerpt}</p></div><span class="chapter-time">{readingTime(a.body||'')} min<span class="chapter-read-marker" data-book-completion hidden> · Leído ✓</span></span></a></li>;})}</ol></section>)}<aside class="book-appendices" aria-label="Para ampliar"><a href={sitePath('/archivo/')}>Buscar por temas ↗</a><a href={sitePath('/biblioteca/')}>Biblioteca ↗</a><a href={sitePath('/laboratorio/')}>Ejemplos interactivos ↗</a><a href={sitePath('/expedientes/')}>Casos documentados ↗</a></aside></div></div></BaseLayout>
