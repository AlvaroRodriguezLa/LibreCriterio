---
import {getCollection,render} from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import {categoryPath,readingTime,sitePath,articlePath} from '../../lib/content';import {categoryLabel,siteConfig} from '../../config/site';import ArticleCard from '../../components/ArticleCard.astro';import ReadingRouteNav from '../../components/ReadingRouteNav.astro';
export async function getStaticPaths(){return (await getCollection('articles',({data})=>!data.draft)).map(article=>({params:{slug:article.data.slug},props:{article}}));}
const {article}=Astro.props;const {Content,headings}=await render(article);const {data}=article;
const all=await getCollection('articles',({data})=>!data.draft);const related=data.related.map((slug:string)=>all.find(a=>a.data.slug===slug)).filter(Boolean);
const url=new URL(articlePath(data.slug),Astro.site||siteConfig.baseUrl).toString();
const jsonld={'@context':'https://schema.org','@type':'Article',headline:data.title,description:data.excerpt,datePublished:data.date.toISOString(),author:{'@type':'Person',name:siteConfig.author},image:new URL(sitePath(data.image),Astro.site||siteConfig.baseUrl).toString(),mainEntityOfPage:url};
---
<BaseLayout title={data.title} description={data.excerpt} socialImage={sitePath(`/social/${data.slug}.png`)}><script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonld).replaceAll('<','\\u003c')}/><div class="reading-progress" aria-hidden="true"><span id="reading-progress"></span></div>
<article class="wrapper essay"><header class="essay-header"><p class="eyebrow"><a href={categoryPath(data.category)}>{categoryLabel(data.category)}</a> / CUADERNO {String(data.order).padStart(2,'0')}</p><h1>{data.title}</h1><p class="essay-deck">{data.excerpt}</p><div class="essay-byline"><span>Álvaro Rodríguez</span><time datetime={data.date.toISOString()}>{data.date.toLocaleDateString('es-ES',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time><span>{readingTime(article.body||'')} min · {data.level}</span><button type="button" data-copy-link>Copiar enlace ↗</button><button type="button" id="print-article">Imprimir</button></div></header>
<div class="essay-grid"><aside class="essay-nav"><img src={sitePath(data.image)} width="720" height="540" alt={data.imageAlt}/><p class="eyebrow">EN ESTE ENSAYO</p><nav aria-label="Índice del ensayo"><ol>{headings.filter((h:{depth:number})=>h.depth===2).map((h:{slug:string;text:string})=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav><div class="essay-origin"><p class="eyebrow">HILO DE LECTURA</p><p>{data.thesis}</p><a href={sitePath('/rutas/')}>Ver las rutas ↗</a></div></aside><div class="article-body essay-body"><Content/><ReadingRouteNav slug={data.slug} articles={all}/><a class="text-button" href={sitePath('/archivo/')}>Volver a los ensayos ↗</a></div></div></article>
{related.length>0&&<section class="wrapper section-pad"><div class="section-top"><h2>La conversación<br/><em>continúa.</em></h2></div><div class="article-grid-list">{related.map((a:any)=><ArticleCard article={a}/>)}</div></section>}
</BaseLayout>
<script>
document.querySelector('[data-copy-link]')?.addEventListener('click',async(event)=>{const b=event.currentTarget as HTMLButtonElement;try{await navigator.clipboard.writeText(location.href);b.textContent='Enlace copiado';}catch{b.textContent='Copia la URL del navegador';}});document.querySelector('#print-article')?.addEventListener('click',()=>window.print());
const progress=document.querySelector<HTMLElement>('#reading-progress');function update(){const height=document.documentElement.scrollHeight-innerHeight;if(progress)progress.style.width=`${height>0?Math.min(100,scrollY/height*100):100}%`;}addEventListener('scroll',update,{passive:true});update();
</script>
