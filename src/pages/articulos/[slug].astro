---
import {getCollection,render} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {readingTime,sitePath,articlePath} from '../../lib/content';
import {siteConfig} from '../../config/site';
import parts from '../../data/routes.json';
import book from '../../data/book.json';
import {getBookChapter,buildBook} from '../../lib/reading-book.mjs';
import ReaderSettings from '../../components/ReaderSettings.astro';
import BookDialog from '../../components/BookDialog.astro';
import BookNavigation from '../../components/BookNavigation.astro';
export async function getStaticPaths(){return(await getCollection('articles',({data})=>!data.draft)).map(article=>({params:{slug:article.data.slug},props:{article}}));}
const {article}=Astro.props;const {Content,headings}=await render(article);const {data}=article;
const all=await getCollection('articles',({data})=>!data.draft);const chapter=getBookChapter(parts,data.slug);const chapters=buildBook(parts);const sectionHeadings=headings.filter(h=>h.depth===2&&h.text!=='Lecturas y fuentes');
const titleOf=(slug:string)=>all.find(a=>a.data.slug===slug)?.data.title||slug;
const url=new URL(articlePath(data.slug),Astro.site||siteConfig.baseUrl).toString();
const jsonld={'@context':'https://schema.org','@type':'Article',headline:data.title,description:data.excerpt,datePublished:data.date.toISOString(),author:{'@type':'Person',name:siteConfig.author},image:new URL(sitePath(data.image),Astro.site||siteConfig.baseUrl).toString(),mainEntityOfPage:url,isPartOf:{'@type':'Book',name:book.title}};
---
<BaseLayout title={data.title} description={data.excerpt} socialImage={sitePath(`/social/${data.slug}.png`)} reader><script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonld).replaceAll('<','\u003c')}/>
<div class="reader-toolbar"><div class="reader-toolbar-inner"><a class="reader-index-link" href={sitePath('/rutas/')+'#capitulo-'+data.slug} data-open-book>Índice <span aria-hidden="true">≡</span></a><div class="reader-location"><span>Cap. {chapter?.number} / {chapter?.total}</span><span class="reader-toolbar-title">{data.title}</span></div><span class="reader-percentage" data-chapter-progress aria-label="Progreso del capítulo">0 %</span><ReaderSettings/></div><div class="reader-progress-track" aria-hidden="true"><span data-chapter-progress-bar></span></div></div>
<article class="wrapper book-chapter" data-reader-root data-reader-slug={data.slug} data-reader-title={data.title} data-reader-number={chapter?.number} data-reader-total={chapter?.total} data-reader-url={articlePath(data.slug)}>
<header class="book-chapter-header"><a class="book-name" href={sitePath('/rutas/')}>{book.title}</a><p class="eyebrow">PARTE {chapter?.partNumber} · {chapter?.partTitle}</p><h1>{data.title}</h1><p class="book-chapter-deck">{data.excerpt}</p><p class="book-chapter-meta">Capítulo {chapter?.number} de {chapter?.total}<span aria-hidden="true"> · </span>{readingTime(article.body||'')} min de lectura estimada</p>{chapter?.partStep===1&&<p class="part-opening">{chapter.partOpening}</p>}</header>
<div class="reader-resume-inline" data-resume-inline hidden><p>Ya empezaste este capítulo. Puedes seguir desde tu última sección.</p><button type="button" data-resume-here>Retomar aquí →</button></div>
<div class="book-chapter-layout"><aside class="reader-sidebar"><details class="chapter-toc"><summary>En este capítulo <span aria-hidden="true">+</span></summary><nav aria-label="Secciones de este capítulo" data-section-toc><ol>{sectionHeadings.map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}</ol></nav></details><details class="part-toc"><summary>Esta parte del libro <span aria-hidden="true">+</span></summary><nav aria-label="Capítulos de esta parte"><ol>{chapters.filter(c=>c.partId===chapter?.partId).map(c=><li><a href={articlePath(c.slug)} aria-current={c.slug===data.slug?'page':undefined}><span>{String(c.number).padStart(2,'0')}</span>{titleOf(c.slug)}</a></li>)}</ol></nav></details></aside><div class="chapter-reading-column"><div class="article-body essay-body chapter-prose" data-reader-body><Content/></div><BookNavigation slug={data.slug} articles={all}/></div></div>
</article><BookDialog slug={data.slug} articles={all}/>
</BaseLayout>
