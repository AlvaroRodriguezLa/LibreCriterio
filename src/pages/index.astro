---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {getPublishedArticles,articlePath,sitePath,categoryPath} from '../lib/content';
import {categoryConfig} from '../config/site';
const articles=(await getPublishedArticles()).sort((a,b)=>a.data.order-b.data.order);
const featured=articles.filter(a=>a.data.featured).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()||b.data.order-a.data.order)[0]||articles[0];
const selected=articles.filter(a=>a.id!==featured.id).slice(0,6);
---
<BaseLayout><section class="wrapper masthead"><div class="edition"><span>UNA PUBLICACIÓN INDEPENDIENTE</span><span>LIBERTAD · ECONOMÍA · PODER</span></div><div class="masthead-grid"><h1>Tu vida.<br/>Tu <em>criterio.</em></h1><div class="masthead-note"><span class="issue-number">01 —</span><p>Una sociedad libre no necesita que todos quieran lo mismo.</p><a class="text-button" href={sitePath('/rutas/')}>Empieza a explorar <span aria-hidden="true">↗</span></a></div></div></section>
<section class="wrapper lead-story" aria-labelledby="featured-title"><div class="lead-copy"><p class="eyebrow">EL ENSAYO DE APERTURA / {String(featured.data.order).padStart(2,'0')}</p><h2 id="featured-title"><a href={articlePath(featured.data.slug)}>{featured.data.title}</a></h2><p>{featured.data.excerpt}</p><a class="text-button" href={articlePath(featured.data.slug)}>Leer el ensayo ↗</a></div><a class="lead-art" href={articlePath(featured.data.slug)} aria-label={`Leer ${featured.data.title}`}><img src={sitePath(featured.data.image)} width="720" height="540" alt={featured.data.imageAlt}/><span>EL PODER DE PODER ELEGIR</span></a></section>
<section class="wrapper section-pad" id="secciones"><div class="section-top"><h2>Ideas que merecen<br/><em>una segunda mirada.</em></h2><a class="text-button" href={sitePath('/archivo/')}>Todos los ensayos ({articles.length}) ↗</a></div><div class="article-grid-list">{selected.map(article=><ArticleCard article={article}/>)}</div></section>
<section class="quote-band"><div class="wrapper"><p class="eyebrow">LA PREGUNTA QUE RECORRE ESTOS CUADERNOS</p><p class="big-quote">¿Quién decide,<br/>con qué información<br/>y <em>a costa de quién?</em></p><p>Derechos, conocimiento e incentivos: tres formas de mirar el mismo poder.</p><a class="text-button" href={sitePath('/laboratorio/')}>Explorar los mecanismos ↗</a></div></section>
<section class="wrapper section-pad"><div class="section-top"><h2>Un mapa.<br/><em>Seis entradas.</em></h2><p>No hace falta empezar por el principio.<br/>Sigue la pregunta que te interese.</p></div><div class="topic-directory">{categoryConfig.map((c,i)=><a href={categoryPath(c.source)}><span class="topic-number">0{i+1}</span><h3>{c.label}</h3><p>{c.description}</p><span aria-hidden="true">↗</span></a>)}</div></section>
<section class="wrapper reading-band"><p class="eyebrow">UNA TRADICIÓN, MUCHAS VOCES</p><h2>Hayek, Mises, Buchanan.<br/>Y las preguntas que<br/><em>dejaron abiertas.</em></h2><p>Textos clásicos, interlocutores contemporáneos y objeciones serias. Una biblioteca comentada para profundizar sin perderse.</p><a class="text-button" href={sitePath('/biblioteca/')}>Abrir la biblioteca ↗</a></section>
</BaseLayout>
