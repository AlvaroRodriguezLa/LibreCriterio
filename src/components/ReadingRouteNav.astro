---
import routes from '../data/routes.json';
import {getReadingSteps} from '../lib/reading-routes.mjs';
import {sitePath,articlePath} from '../lib/content';
const {slug,articles}=Astro.props;
const steps=getReadingSteps(routes,slug);
const titleOf=(s:string)=>articles.find((a:any)=>a.data.slug===s)?.data.title || s;
const href=(s:string,id:string)=>articlePath(s)+'?ruta='+id;
---
{steps.length>0&&<nav class="reading-route" aria-label="Continuar la ruta de lectura">{steps.map((r:any,i:number)=><div data-reading-route={r.id} hidden={i>0}>
<p class="eyebrow">RUTA {r.id} · {r.step} DE {r.total}</p><h2>{r.title}</h2>
<div class="reading-route-links">
{r.previous&&<a class="route-previous" href={href(r.previous,r.id)}><span>← Anterior · Ruta {r.id} — {r.step-1}</span><strong>{titleOf(r.previous)}</strong></a>}
{r.next?<a class="route-next" href={href(r.next,r.id)}><span>Continuar · Ruta {r.id} — {r.step+1} →</span><strong>{titleOf(r.next)}</strong></a>:<div class="route-complete"><strong>Has completado esta ruta.</strong><p>Puedes volver a un ensayo o elegir tu próximo recorrido.</p></div>}
</div><a class="route-index" href={sitePath('/rutas/')+'#ruta-'+r.id}>Ver los pasos de la ruta {r.id} ↗</a>
</div>)}</nav>}
<script>
import {selectReadingRoute} from '../lib/reading-routes.mjs';
const panels=Array.from(document.querySelectorAll<HTMLElement>('[data-reading-route]'));
const selected=selectReadingRoute(panels.map(panel=>({id:panel.dataset.readingRoute})),new URLSearchParams(location.search).get('ruta'));
for(const panel of panels)panel.hidden=panel.dataset.readingRoute!==selected?.id;
</script>
